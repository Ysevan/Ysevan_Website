{
 "version": 1,
 "title": "建议点位",
 "note": "建议点位，以电工现场为准。地漏和排污口以现场为准。坐标是平面米，与户型平面同一原点，x 向东，z 向南，y 是离地高度（插座、开关是面板中心，灯是安装面，箱子是箱底）。挂墙的点贴墙面，离墙线不超过3厘米，有墙板、贴砖时落在其面上，厨房挡水板离墙较远，台面插座按墙面给坐标，挡水板开孔。户型 DWG 上本户只有强电箱、弱电箱两个电气图元，标「图纸」，另有空调、冰箱、灶具的位置符号，对应插座也标「图纸」并写明句柄，插座本身的高度和左右位置是建议。其余都是建议，按规范下限和常见安装高度定，低位插座面板中心离地0.35米（底边约0.30米）。贴在承重墙面的点线盒浅装，不横向开槽，开槽前核对。灯位以模型现有的灯为底，模型没有的卧室主灯和阳台灯另补，只在平面上示意。只做布置01和04，02和03的面板仍是原示意。",
 "standards": [
  {
   "id": "GB50096",
   "name": "GB 50096-2011 住宅设计规范",
   "clause": "8.7.4、8.7.6、8.7.7",
   "summary": "8.7.4 套内装在1.8米及以下的插座用安全型。8.7.6 按房间给出电源插座的最少数量（表 8.7.6），起居室、卧室、厨房、卫生间各有下限，厨房和卫生间用防溅水型，洗衣机、冰箱、排油烟机、排风机、空调、电热水器等位置设专用插座。8.7.7 对电视和网络插座作了规定，起居室和主卧要有电视插座，起居室、卧室要有网络插座。以上是大意，以原文为准。"
  },
  {
   "id": "JGJ242",
   "name": "JGJ 242-2011 住宅建筑电气设计规范",
   "clause": "8.5.1、8.5.4、8.5.5、8.5.6",
   "summary": "8.5.1 按房间给出套内插座的最少数量（表 8.5.1），比 GB 50096 多列了书房。8.5.4、8.5.5 对插座的型式、电流等级和专用回路作了规定，厨房、卫生间插座要防溅。8.5.6 卫生间插座按分区设置，淋浴区及其周边0.6米内不设普通插座。以上是大意，以原文为准。"
  },
  {
   "id": "GB50303",
   "name": "GB 50303-2015 建筑电气工程施工质量验收规范",
   "clause": "",
   "summary": "开关装在门开启侧，离门框边常见0.15至0.20米，本表开关位置按这个做法，条号未核，只写规范名。"
  }
 ],
